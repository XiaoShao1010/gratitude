<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/surface_background"
                android:centerColor="@color/surface_background_deep"
                android:endColor="@color/surface_background" />
        </shape>
    </item>

    <item android:left="-120dp" android:top="-120dp">
        <shape android:shape="oval">
            <size android:width="300dp" android:height="300dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="150dp"
                android:centerColor="#3359B8FF"
                android:endColor="#0059B8FF" />
        </shape>
    </item>

    <item android:right="-160dp" android:top="80dp">
        <shape android:shape="oval">
            <size android:width="340dp" android:height="340dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="170dp"
                android:centerColor="#2238BDF8"
                android:endColor="#0038BDF8" />
        </shape>
    </item>
</layer-list>